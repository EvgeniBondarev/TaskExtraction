# Скопируйте: cp .env.example .env
# Не коммитьте .env в git.

# Шифрование Telegram-учётных данных и токенов интеграций в БД (обязательно)
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Telegram (опционально, если не настраиваете через UI)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHAT_ID=
TELEGRAM_SESSION_PATH=/app/data/session

# База данных (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./data/taskextraction.db

# LLM: свой ключ и модель — в разделе «Настройки → LLM» в панели
LLM_CONFIDENCE_THRESHOLD=0.7

# Панель
ASSIGNEES=Оператор,Разработчик,Менеджер
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Файлы вложений из Telegram
MEDIA_DIR=/app/data/media

# Публичный URL панели (для ссылок в Jira/Trello/GitHub/Slack)
PUBLIC_API_URL=http://localhost:8080

# Секрет подписи cookie-сессии панели (по умолчанию производный от ENCRYPTION_KEY)
# SESSION_SECRET=

# Публичный URL фронтенда (HTTPS) — обязателен для превью ссылок в Telegram/WhatsApp
# Подставляется в og:image, og:url, sitemap при сборке. Должен совпадать с адресом в браузере.
# Пример: https://task-extraction.gazonyh.ru
# Локально: http://localhost:5173 (превью в мессенджерах снаружи не заработают)
VITE_SITE_URL=

# Интеграции (опционально, можно задать в UI)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

YOUTRACK_BASE_URL=
YOUTRACK_TOKEN=
YOUTRACK_PROJECT_ID=
