# Скопируйте: cp .env.example .env
# Не коммитьте .env в git.

# Шифрование Telegram-учётных данных и токенов интеграций в БД (обязательно)
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Telegram Bot API — основной способ приёма сообщений.
# Создайте бота через @BotFather. Для чтения всех сообщений группы отключите
# Privacy Mode или назначьте бота администратором. Не коммитьте токен.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=TaskExtractionBot
# Случайный секрет: Telegram отправляет его в HTTP-заголовке webhook-а.
TELEGRAM_WEBHOOK_SECRET=
# Только локально: получает обновления без публичного HTTPS URL. На сервере — false.
TELEGRAM_BOT_POLLING=false
# Вход в панель: Web application OAuth client из Google Cloud Console.
# Redirect URI должен точно совпадать: https://ваш-домен/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
PUBLIC_WEB_URL=http://localhost:5173
# Публичный HTTPS URL панели — используется Telegram-кнопкой «Открыть карточку».
TASK_PANEL_URL=https://task-extraction.ru

# База данных (SQLite)
# docker compose: volume app_data → /app/data
# uvicorn из backend/: раскомментируйте локальные пути ниже
DATA_DIR=./data
DATABASE_URL=sqlite+aiosqlite:////app/data/taskextraction.db
# DATABASE_URL=sqlite+aiosqlite:///./data/taskextraction.db

# Не отключайте ingest в dev/prod — иначе сообщения из Telegram не поступают (только для pytest: TE_DISABLE_INGEST=1)

# LLM: свой ключ и модель — в разделе «Настройки → LLM» в панели
LLM_CONFIDENCE_THRESHOLD=0.7

# TypeSafe Jev: structured task decisions through OpenRouter Decisions API.
# This key stays server-side; use a separate OpenRouter key where possible.
JEV_OPENROUTER_API_KEY=
JEV_OPENROUTER_MODEL=~typesafe/jev-latest

# Панель
ASSIGNEES=Оператор,Разработчик,Менеджер
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Файлы вложений из Telegram
MEDIA_DIR=/app/data/media

# Публичный URL панели (для ссылок в Jira/Trello/GitHub/Slack)
PUBLIC_API_URL=http://localhost:8080

# Секрет подписи cookie-сессии панели (по умолчанию производный от ENCRYPTION_KEY)
# SESSION_SECRET=

# Админ-панель (/admin) — аналитика UTM
ADMIN_USERNAME=root
ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=

# Вкладка «Аналитика» в основной панели. Доступен только этому Google email.
ANALYTICS_OWNER_EMAIL=bondareff7@gmail.com

# Публичный URL фронтенда (HTTPS) — обязателен для OG, sitemap.xml и robots.txt при сборке
# Продакшен: https://task-extraction.ru
# Локально: http://localhost:5173 (превью и SEO для поисковиков снаружи не заработают)
VITE_SITE_URL=

# Подтверждение сайта в панелях веб-мастеров (meta-теги в index.html при сборке)
# Яндекс.Вебмастер → Подтверждение → meta-тег
# VITE_YANDEX_VERIFICATION=
# Google Search Console → HTML-тег
# VITE_GOOGLE_SITE_VERIFICATION=

# Интеграции (опционально, можно задать в UI)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

YOUTRACK_BASE_URL=
YOUTRACK_TOKEN=
YOUTRACK_PROJECT_ID=
